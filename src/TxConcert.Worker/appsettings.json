{
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "App": {
    "Name": "tx-concert-worker",
    "Environment": "Development"
  },
  "Redis": {
    "Host": "localhost",
    "Port": 6379,
    "Password": "",
    "Db": 0,
    "KeyPrefix": "tx-concert"
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VHost": "/",
    "Username": "guest",
